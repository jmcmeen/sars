            "title": "Interval"
          },
          "log_area": {
            "default": true,
            "title": "Log Area",
            "type": "boolean"
          },
          "models": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 32,
                  "pattern": "^[A-Za-z][A-Za-z0-9]*$",
                  "type": "string"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "default: ContOne, ZslopeOne, Linear",
            "title": "Models"
          }
        },
        "title": "ThresholdRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Each endpoint runs one `sars` command (see the command line documentation) and returns its JSON envelope: `{sars, command, ok, result | error, warnings}`. A failed command returns 422 with `ok: false`.",
    "summary": "Species-area relationship models over HTTP",
    "title": "sars",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/average": {
      "post": {
        "description": "The model average (`sars average`).",
        "operationId": "average_v1_average_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AverageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Average",
        "tags": [
          "models"
        ]
      }
    },
