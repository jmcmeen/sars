{
  "components": {
    "schemas": {
      "AverageRequest": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataset": {
            "anyOf": [
              {
                "enum": [
                  "galap",
                  "gala",
                  "aegean",
                  "aegean2",
                  "niering",
                  "schrader",
                  "xu"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "a bundled dataset (GET /v1/datasets)",
            "title": "Dataset"
          },
          "homoscedasticity": {
            "anyOf": [
              {
                "enum": [
                  "cor.fitted",
                  "cor.area"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Homoscedasticity"
          },
          "ic": {
            "default": "AICc",
            "enum": [
              "AICc",
              "AIC",
              "BIC"
            ],
            "title": "Ic",
            "type": "string"
          },
          "models": {
            "default": [
              "all"
            ],
            "items": {
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Models",
            "type": "array"
          },
          "neg_check": {
            "default": false,
            "title": "Neg Check",
            "type": "boolean"
          },
          "normality": {
            "anyOf": [
              {
                "enum": [
                  "shapiro",
                  "lillie",
                  "kolmogorov"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normality"
          }
        },
        "title": "AverageRequest",
        "type": "object"
      },
      "CVRequest": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataset": {
            "anyOf": [
              {
                "enum": [
                  "galap",
                  "gala",
                  "aegean",
                  "aegean2",
                  "niering",
                  "schrader",
                  "xu"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "a bundled dataset (GET /v1/datasets)",
            "title": "Dataset"
          },
          "ic": {
            "default": "AICc",
            "enum": [
              "AICc",
              "AIC",
              "BIC"
            ],
            "title": "Ic",
            "type": "string"
          },
          "models": {
            "default": [
              "all"
            ],
            "items": {
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Models",
            "type": "array"
          },
          "n_jobs": {
            "default": 1,
            "description": "processes; -1: the server's limit",
            "maximum": 64.0,
            "minimum": -1.0,
            "title": "N Jobs",
            "type": "integer"
          },
          "warm": {
            "default": false,
            "title": "Warm",
            "type": "boolean"
          }
        },
        "title": "CVRequest",
        "type": "object"
      },
      "Data": {
        "description": "Species-area data: an area and a richness per site, and optionally a\nname per site (used to label results).",
        "properties": {
          "area": {
            "items": {
              "type": "number"
            },
            "maxItems": 100000,
            "minItems": 1,
            "title": "Area",
            "type": "array"
          },
          "label": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 100000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "species": {
            "items": {
              "type": "number"
            },
            "maxItems": 100000,
            "minItems": 1,
            "title": "Species",
            "type": "array"
          }
        },
        "required": [
          "area",
          "species"
        ],
        "title": "Data",
        "type": "object"
      },
      "FitRequest": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataset": {
            "anyOf": [
              {
                "enum": [
                  "galap",
                  "gala",
                  "aegean",
                  "aegean2",
