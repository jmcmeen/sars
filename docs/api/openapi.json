            "title": "Dataset"
          },
          "homoscedasticity": {
            "anyOf": [
              {
                "enum": [
                  "cor.fitted",
                  "cor.area"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Homoscedasticity"
          },
          "models": {
            "default": [
              "power"
            ],
            "description": "one model, several, or [\"all\"]",
            "items": {
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Models",
            "type": "array"
          },
          "neg_check": {
            "default": false,
            "title": "Neg Check",
            "type": "boolean"
          },
          "normality": {
            "anyOf": [
              {
                "enum": [
                  "shapiro",
                  "lillie",
                  "kolmogorov"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normality"
          }
        },
        "title": "FitRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LossRequest": {
        "properties": {
          "area": {
            "description": "the area before the loss",
            "items": {
              "type": "number"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Area",
            "type": "array"
          },
          "conf": {
            "default": 0.95,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Conf",
            "type": "number"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataset": {
            "anyOf": [
              {
                "enum": [
                  "galap",
                  "gala",
                  "aegean",
                  "aegean2",
                  "niering",
                  "schrader",
                  "xu"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "a bundled dataset (GET /v1/datasets)",
            "title": "Dataset"
          },
          "fraction_lost": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 1000,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraction Lost"
          },
          "ic": {
            "default": "AICc",
            "enum": [
              "AICc",
              "AIC",
              "BIC"
            ],
            "title": "Ic",
            "type": "string"
          },
          "models": {
            "default": [
              "all"
            ],
            "items": {
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Models",
            "type": "array"
          },
          "n_boot": {
            "default": 1000,
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "N Boot",
            "type": "integer"
          },
          "n_jobs": {
            "default": 1,
            "description": "processes; -1: the server's limit",
            "maximum": 64.0,
            "minimum": -1.0,
            "title": "N Jobs",
            "type": "integer"
          },
          "remaining": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 1000,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "required": [
          "area"
        ],
        "title": "LossRequest",
        "type": "object"
      },
      "PredictRequest": {
        "properties": {
          "areas": {
            "items": {
              "type": "number"
            },
            "maxItems": 100000,
            "minItems": 1,
            "title": "Areas",
            "type": "array"
          },
          "result": {
            "additionalProperties": true,
            "description": "a result saved by --save, or an envelope's result.object",
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result",
          "areas"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "ThresholdRequest": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataset": {
            "anyOf": [
              {
                "enum": [
                  "galap",
                  "gala",
                  "aegean",
                  "aegean2",
                  "niering",
                  "schrader",
                  "xu"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "a bundled dataset (GET /v1/datasets)",
            "title": "Dataset"
          },
          "interval": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
